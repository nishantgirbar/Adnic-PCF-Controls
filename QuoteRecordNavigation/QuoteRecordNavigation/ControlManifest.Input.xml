<?xml version="1.0" encoding="utf-8"?>
<manifest>
  <control namespace="ADNIC.Controls"
           constructor="QuoteRecordNavigation"
           version="1.0.2"
           display-name-key="Quote record navigation"
           description-key="Displays quote references as links that open Dataverse forms."
           control-type="standard">
           
    <property name="recordReferences"
              display-name-key="Record references"
              description-key="Pipe-separated quote numbers, for example QA2121 | Q3443 | QT434343."
              of-type="SingleLine.Text"
              usage="bound"
              required="true" />
    <property
      name="quoteId"
      display-name-key="quoteId_Display"
      description-key="quoteId_Desc"
      of-type="Whole.None"
      usage="bound"
      required="true" />

    <feature-usage>
      <uses-feature name="WebAPI" required="true" />
    </feature-usage>
    <resources>
      <code path="index.ts" order="1" />
      <css path="css/QuoteRecordNavigation.css" order="1" />
    </resources>
  </control>
</manifest>
