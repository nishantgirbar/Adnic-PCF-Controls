<?xml version="1.0" encoding="utf-8"?>
<manifest>
  <control namespace="ADNIC.Controls"
           constructor="QuoteRecordNavigation"
           version="1.2.3"
           display-name-key="Quote record navigation"
           description-key="Displays quote references as links that open Dataverse forms."
           control-type="standard">
           
    <property name="quoteNumber"
              display-name-key="Quote number"
              description-key="The current quote number."
              of-type="SingleLine.Text"
              usage="bound"
              required="true" />
    <property
      name="quoteId"
      display-name-key="quoteId_Display"
      description-key="quoteId_Desc"
      of-type="Whole.None"
      usage="bound"
      required="true" />
    <property
      name="quoteIterationNumber"
      display-name-key="Quote iteration number"
      description-key="The highest iteration number available for this quote."
      of-type="Whole.None"
      usage="bound"
      required="true" />

    <feature-usage>
      <uses-feature name="WebAPI" required="true" />
    </feature-usage>
    <resources>
      <code path="index.ts" order="1" />
      <css path="css/QuoteRecordNavigation.css" order="1" />
    </resources>
  </control>
</manifest>
