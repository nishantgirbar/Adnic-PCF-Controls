<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="PolicyCustomGrid"
           constructor="CustomGridB2E"
           version="2.1.1"
           display-name-key="PolicyGrid"
           description-key="Policy Grid Control"
           control-type="standard">

    <property
    name="validatedMembersJson"
    of-type="SingleLine.Text"
    usage="output"
    display-name-key="ValidatedMembersJson"
    description-key="Validated Members JSON"
    required="false" />

    <!-- ✅ Dataset (CRM fallback / optional) -->
    <data-set name="dataset"
              display-name-key="Dataset"
              description-key="Dataset for grid" />

    <!-- ✅ Resources -->
    <resources>
      <code path="index.ts" order="1" />
      <css path="css/PolicyGrid.css" order="2" />
      <!-- Optional but recommended -->
      <!-- <css path="css/PolicyGrid.css" order="2" /> -->
    </resources>

    <feature-usage>
    <uses-feature
      name="WebAPI"
      required="true" />
  </feature-usage>

  </control>
</manifest>